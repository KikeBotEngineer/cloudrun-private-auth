# Copiar a deploy/env y completar. deploy/env está en .gitignore.
PROJECT_ID=my-project
REGION=us-central1

API_SERVICE=sample-api
GATEWAY_SERVICE=api-key-gateway
GATEWAY_SA=api-key-gateway
# Secreto de Secret Manager con el valor de API_KEYS (consumidor:sha256,...)
API_KEYS_SECRET=gateway-api-keys
ALLOWED_ROUTES="GET /health,GET /whoami"
UPSTREAM_TIMEOUT_SECONDS=10
# Tope de instancias del gateway: sin rate limiting, acota el costo de un abuso.
GATEWAY_MAX_INSTANCES=3

# Workload Identity Federation (GitHub Actions)
GITHUB_REPO=my-org/cloudrun-private-auth
WIF_POOL=github
WIF_PROVIDER=github
CI_SA=github-ci
